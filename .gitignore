# Xcode derived and build files
DerivedData/
build/
*.xcworkspace/
*.xcuserstate
*.xcuserdata/
# Per-user Xcode state: schemes, breakpoints, window layout. The `*.xcuserdata/`
# rule above never matched these — it needs something before a literal
# `.xcuserdata`, whereas the real directories are a plain `xcuserdata/` inside
# `.xcodeproj/`, `project.xcworkspace/` and `.swiftpm/xcode/`. Eight such files
# were tracked under two machine identities (joecursio, josephcursio), so every
# machine switch showed a spurious diff. Untracked in the same commit as this
# rule — .gitignore does not apply to already-tracked files.
xcuserdata/
*.xcarchive/
*.xcsettings
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.xcplugindata/
*.xcresult/
*.pcm
*.dSYM/
*.app/
*.ipa
*.tmp
*.swp
*.lock
*.crash

# Swift Package Manager
.swiftpm/
.package/
.build/
Package.resolved

# CocoaPods and Carthage
Pods/
Carthage/
Carthage.build/

# System files
.DS_Store

# Test results
test_results/
debug_output/

# Ignore specific derived files
TestResults.xcresult/Data/data.0*
*.mdb

# Output and logs
Output/

# SwiftLint config edit-tool backups
.swiftlint.yml.*.backup

# Project documentation and scripts (optional, if you want to ignore generated or local-only files)
# Docs/
# Scripts/

# Centralized tests (optional, if you want to ignore generated or local-only files)
# Tests/

# Road-test raw output. The `Output/` rule above matches this directory too —
# git on macOS is case-insensitive by default, so `Docs/roadtest/output/` was
# being swallowed whole, README included. Re-include it, then exclude only the
# large artifacts by name.
!Docs/roadtest/output/

# Reproducible on demand, too large to archive.
# The committed subset and the regeneration commands are in
# Docs/roadtest/output/README.md, which lists these by name so their
# absence is visible rather than silent.
Docs/roadtest/output/lint-report.txt
Docs/roadtest/output/lint-report.json
Docs/roadtest/output/seed-manifest.json
Docs/roadtest/output/discover-SwiftProjectLintVisitors.txt
Docs/roadtest/output/discover-SwiftProjectLintRules.txt
